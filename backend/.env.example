# Local Postgres (default for offline / teammate machines):
DATABASE_URL=postgresql+psycopg://crm:crm@localhost:5432/crm
# Supabase (cloud): use Project Settings → Database → Connection string.
# Prefer "Session pooler" (port 5432) over direct db.<ref>.supabase.co when DNS
# fails or you are on restricted networks. Example shape:
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# If you see "max clients reached in session mode", either:
#   1) Restart the backend (stale uvicorn workers leak sessions), or
#   2) Switch to Transaction pooler on port 6543 (higher concurrency):
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Keep the project Active (not paused) in the Supabase dashboard.
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
# Bootstrap admin only (seed). Create all other employees in Admin → Employees (local DB).
ADMIN_EMAIL=admin@crm.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Administrator
STORAGE_DIR=../storage
MAX_UPLOAD_MB=15
OPEN_LEAD_LIMIT=3
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Email via SMTP — paste real values in your local .env (never commit the password)
EMAIL_ENABLED=true
SMTP_HOST=mail.estar.in
SMTP_PORT=465
SMTP_USERNAME=crm@estar.in
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_USE_TLS=false
SMTP_TIMEOUT=30
SMTP_FROM_EMAIL=crm@estar.in
SMTP_FROM_NAME=E-Star CRM
# Assignment mail: 50 leads per email, reuse one SMTP session for up to 40 messages.
ASSIGNMENT_EMAIL_CHUNK=50
EMAIL_SESSION_MESSAGE_LIMIT=40
EMAIL_SEND_ATTEMPTS=3
# Retry failed assignment mails every 2 minutes; do not touch leads newer than 2 minutes.
ASSIGNMENT_RETRY_MINUTES=2
ASSIGNMENT_EMAIL_GRACE_SECONDS=120
SLA_SWEEP_MINUTES=5
OVERDUE_DIGEST_HOUR=9
